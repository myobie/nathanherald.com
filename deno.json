{
  "compilerOptions": {
    "lib": ["deno.ns", "dom"]
  },
  "tasks": {
    "build": "deno run -A src/build.ts",
    "dev": "deno run -A --watch src/dev.ts",
    "test": "cd tests && PLAYWRIGHT_BROWSERS_PATH=/tmp/pw-browsers npx playwright test --config playwright.config.ts",
    "test:unit": "deno test -A --no-check tests/unit/"
  },
  "imports": {
    "dom": "./src/elements/dom.ts"
  }
}
