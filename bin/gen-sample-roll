#!/usr/bin/env bash
# Generate a fake roll of film in src/photos/rolls/sample/ so the contact sheet
# page can be built and looked at without real scans. Output is gitignored.
#
# Usage: bin/gen-sample-roll [frames] [format]
#   bin/gen-sample-roll 37 35mm
#   bin/gen-sample-roll 12 120-6x6

set -euo pipefail

FRAMES="${1:-37}"
FORMAT="${2:-35mm}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/src/photos/rolls/sample"

if command -v magick >/dev/null; then IM=(magick); else IM=(convert); fi

rm -rf "$OUT"
mkdir -p "$OUT"

# Fixed ratings so the marks are easy to check: 5s get circles, 1s and 2s get Xs.
# Every frame is rated: the build refuses rolls with unrated (0) frames.
RATINGS=(3 3 5 2 4 4 3 1 3 4 5 3 4 2 3 3 3 4 5 1 4 3 3 2 4 4 5 3 3 1 4 3 4 3 2 5 3)

frames_json=""
for ((n = 1; n <= FRAMES; n++)); do
  base=$(printf "%02d" "$n")
  rating=${RATINGS[$(((n - 1) % ${#RATINGS[@]}))]}
  # a few portrait frames, like turning the camera
  if ((n % 7 == 0)); then w=640; h=960; else w=960; h=640; fi
  if [[ "$FORMAT" == 120-6x6 ]]; then w=800; h=800; fi

  "${IM[@]}" -seed "$n" -size "${w}x${h}" plasma:grey60-grey15 \
    -colorspace Gray -blur 0x3 -attenuate 0.6 +noise Gaussian \
    -sigmoidal-contrast 4x50% -strip -interlace none -quality 75 \
    "$OUT/$base.jpg"
  "${IM[@]}" "$OUT/$base.jpg" -resize 640x640 -strip -quality 75 "$OUT/$base.thumb.jpg"

  long=$((w > h ? w : h))
  frames_json+=$(printf '%s\n    {"n": %d, "assetId": "sample-%s", "filename": "P92508%02d.ORF", "rating": %d, "flag": 0, "width": %d, "height": %d, "thumb": "%s.thumb.jpg", "image": "%s.jpg", "imageLongSide": %d}' \
    "${frames_json:+,}" "$n" "$base" "$n" "$rating" "$w" "$h" "$base" "$base" "$long")
done

cat > "$OUT/roll.json" <<JSON
{
  "slug": "sample",
  "title": "Sample roll",
  "film": "Ilford HP5+",
  "format": "$FORMAT",
  "camera": "Leica M7",
  "shot": "2026-09",
  "scanned": "2026-09-25",
  "notes": "Fake frames generated by bin/gen-sample-roll, for checking the layout.",
  "source": { "album": "Sample", "from": null, "to": null },
  "frames": [$frames_json
  ]
}
JSON

echo "Wrote $FRAMES frames to ${OUT#$ROOT/}"
