#!/usr/bin/env bash
#
# lr-roll: turn a roll of film in the local Lightroom (cloud) library into
# src/photos/<folders>/<album>/roll.json plus web JPEGs.
#
# Read only. It copies the library's index (Managed Catalog.wfindex) and
# previews.db into a temp dir, queries the copies, and deletes them on exit.
# It never opens originals or RAWs. Images come from Lightroom's own
# (already edited) previews, or from a folder of JPEGs you exported.
#
# Usage:
#   bin/lr-roll --suggest --album "Tegernsee Film"
#   bin/lr-roll --album "Tegernsee Film" --from P9250830 --to P9250867 \
#       --title Tegernsee --film "Ilford HP5+" --camera "Leica M7" \
#       --format 35mm --shot 2026-09 [--slug 2026-09-tegernsee-1] \
#       [--export-dir ~/Desktop/tegernsee-export] [--include-rejected] \
#       [--dry-run] [--force] [--out DIR (default src/photos)] \
#       [--max 1280 (long side of the main image; thumbs are 640)] \
#       [--local (write JPEGs next to roll.json instead of uploading)]
#
# By default the JPEGs are uploaded to the R2 bucket $LR_BUCKET
# (nathanherald-photos) under rolls/<slug>/, named with a content hash so they
# can be cached forever, and roll.json gets absolute URLs under $LR_BASE_URL
# (https://photos.nathanherald.com). Only roll.json lands in the repo.
#
# From Lightroom it also reads, per frame:
#   - keyword "Redact": the frame keeps its place on the strip but nothing
#     about it is published (no image, rating, filename or caption)
#   - caption lines starting with ">": a comment on that frame (markdown)
#   - keywords "film: …", "camera: …", "lens: …", "lab: …|home": roll facts
#     (CLI flags --film/--camera/--lens/--lab win; then keywords; then captions)
#   - the caption's "Film stock • format • lab" convention: prefills --film,
#     and --format for "Half frame" / "35mm", when all frames agree
#   - capture times: the shot month, when they were set in Lightroom (well
#     before the import, or spread over more than a scan session)
# With --force, uploads the old roll.json used that the new one doesn't are
# deleted from the bucket. A notes.md beside roll.json is never touched.
#
# Album names repeat ("Film", "Digital", "Ilford HP5+"). If a name matches
# more than one album, the matches are listed and you pass --album-id.
#
# Requires: sqlite3, jq, magick (ImageMagick), deno, and for uploads npx with
# a logged in wrangler (npx wrangler@latest login).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LIB="${LR_LIBRARY:-$HOME/Pictures/Lightroom Library.lrlibrary}"

die() { echo "lr-roll: $*" >&2; exit 1; }

usage() { sed -n '3,40p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

SUGGEST=false DRY_RUN=false FORCE=false INCLUDE_REJECTED=false
ALBUM="" ALBUM_ID="" FROM="" TO="" SLUG="" TITLE="" FILM="" CAMERA=""
FORMAT="35mm" SHOT="" NOTES="" EXPORT_DIR="" GAP=90 MAX=1280
OUT_ROOT="$REPO_ROOT/src/photos"
LOCAL=false FORMAT_SET=false CHECK="" FOLDER="" LAB="" LENS="" TRIP=""
BUCKET="${LR_BUCKET:-nathanherald-photos}"
BASE_URL="${LR_BASE_URL:-https://photos.nathanherald.com}"

while [ $# -gt 0 ]; do
  case "$1" in
    --suggest) SUGGEST=true ;;
    --album) ALBUM="$2"; shift ;;
    --album-id) ALBUM_ID="$2"; shift ;;
    --from) FROM="$2"; shift ;;
    --to) TO="$2"; shift ;;
    --slug) SLUG="$2"; shift ;;
    --title) TITLE="$2"; shift ;;
    --film) FILM="$2"; shift ;;
    --camera) CAMERA="$2"; shift ;;
    --format) FORMAT="$2"; FORMAT_SET=true; shift ;;
    --shot) SHOT="$2"; shift ;;
    --notes) NOTES="$2"; shift ;;
    --export-dir) EXPORT_DIR="$2"; shift ;;
    --gap) GAP="$2"; shift ;;
    --out) OUT_ROOT="$2"; shift ;;
    --max) MAX="$2"; shift ;;
    --local) LOCAL=true ;;
    --check) CHECK="$2"; shift ;;
    --folder) FOLDER="$2"; shift ;;
    --lab) LAB="$2"; shift ;;
    --lens) LENS="$2"; shift ;;
    --trip) TRIP="$2"; shift ;;
    --include-rejected) INCLUDE_REJECTED=true ;;
    --dry-run) DRY_RUN=true ;;
    --force) FORCE=true ;;
    -h|--help) usage 0 ;;
    *) echo "lr-roll: unknown option $1" >&2; usage 1 ;;
  esac
  shift
done

for t in sqlite3 jq magick; do command -v "$t" >/dev/null || die "missing $t"; done
$LOCAL || $SUGGEST || command -v npx >/dev/null || die "missing npx (needed to upload with wrangler, or pass --local)"
BASE_URL="${BASE_URL%/}"
[ -n "$CHECK" ] || [ -n "$ALBUM" ] || [ -n "$ALBUM_ID" ] || { $SUGGEST && [ -n "$FOLDER" ]; } \
  || die "need --album, --album-id, --check, or --suggest --folder"
[ -z "$EXPORT_DIR" ] || [ -d "$EXPORT_DIR" ] || die "no such export dir: $EXPORT_DIR"
[[ "$MAX" =~ ^[0-9]+$ ]] && [ "$MAX" -ge 640 ] || die "--max must be a number >= 640"

# --- Find the active catalog (the one with the newest index) -----------------

CAT=""
for d in "$LIB"/*/; do
  f="$d/Managed Catalog.wfindex"
  [ -f "$f" ] || continue
  if [ -z "$CAT" ] || [ "$f" -nt "$CAT/Managed Catalog.wfindex" ]; then CAT="${d%/}"; fi
done
[ -n "$CAT" ] || die "no catalog found in $LIB"

# --- Temp copies, always removed ---------------------------------------------

TMP="$(mktemp -d "${TMPDIR:-/tmp}/lr-roll.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

copy_db() { # src dest: copy a SQLite file with its WAL/SHM so the copy is current
  local x
  for x in "" -wal -shm; do
    if [ -f "$1$x" ]; then cp "$1$x" "$2$x"; fi
  done
}
copy_db "$CAT/Managed Catalog.wfindex" "$TMP/index.db"
if [ -f "$CAT/previews.db" ]; then
  copy_db "$CAT/previews.db" "$TMP/previews.db"
else
  # Lightroom deletes its preview index while it runs and rebuilds it later,
  # so without it there is no way to match preview files to photos.
  echo "⚠️  Lightroom's preview index (previews.db) is missing; it usually comes back when Lightroom quits." >&2
  echo "   Until then frames have no preview: quit Lightroom, or pass --export-dir with a Lightroom export." >&2
  sqlite3 "$TMP/previews.db" "create table RenditionPath(localAssetId, longSide, path);"
  NO_PREVIEWS=true
fi
$SUGGEST || [ -n "$CHECK" ] || copy_db "$CAT/Managed Catalog.mcat" "$TMP/catalog.db"   # captions live here

q() { sqlite3 -readonly "$TMP/index.db" "$@"; }
sql_str() { printf "'%s'" "${1//\'/\'\'}"; }

# --- Check mode: compare published rolls with Lightroom right now -------------
# Reports published frames that are now marked "Redact" (their images are
# public and must come down: re-export with --force) or are unrated, or
# whose photo is gone from the catalog. Exits 1 if anything needs action.

if [ -n "$CHECK" ]; then
  if [ "$CHECK" = all ]; then
    files="$(find "$OUT_ROOT" -name roll.json -not -path '*/sample/*' | sort)"
  elif [ -f "$CHECK" ]; then files="$CHECK"
  elif [ -f "$OUT_ROOT/$CHECK/roll.json" ]; then files="$OUT_ROOT/$CHECK/roll.json"   # a path like 2026-10/sf-film-photos/01-delta-400
  else  # or a slug / id
    files="$(find "$OUT_ROOT" -name roll.json -not -path '*/sample/*' -exec jq -r --arg s "$CHECK" 'select(.slug == $s) | input_filename' {} + 2>/dev/null)"
    [ -n "$files" ] || die "no roll.json for $CHECK"
  fi
  [ -n "$files" ] || die "no rolls under $OUT_ROOT"
  problems=0
  while IFS= read -r f; do
    slug="$(jq -r .slug "$f")"
    ids="$(jq -r '[.frames[] | select(.redacted != true and .assetId != null) | "'"'"'" + .assetId + "'"'"'"] | join(",")' "$f")"
    [ -n "$ids" ] || { echo "✅ $slug: no published frames"; continue; }
    now="$(q -json "select a.assetId, coalesce(a.rating, 0) as rating,
        exists(select 1 from keywords k where k.docId = a.docId and lower(trim(k.keyword)) = 'redact') as redact,
        (select json_group_array(k.keyword) from keywords k where k.docId = a.docId) as keywords
      from assets a where a.assetId in ($ids);")"
    # Roll facts set by keywords that no longer match what was published.
    drift="$(jq -nr --argjson now "${now:-[]}" --slurpfile r "$f" '
      $r[0] as $roll
      | [ $now[] | (.keywords // "[]") | fromjson[]
          | capture("^\\s*(?<k>film|camera|lens|lab)\\s*:\\s*(?<v>.*?)\\s*$"; "i") | select(.v != "")
          | { k: (.k | ascii_downcase), v } ]
      | group_by(.k) | map({ k: .[0].k, vals: (map(.v) | unique) })[]
      # lens may vary per frame, so only a single agreed lens is compared
      | select(.k != "lens" or (.vals | length) == 1)
      | select((.vals | length) > 1 or (.vals[0] != $roll[.k]))
      | "  \(.k): published \($roll[.k] // "nothing" | tojson), Lightroom keywords say \(.vals | join(" / "))"')"
    report="$(jq -r --argjson now "${now:-[]}" '
      ($now | map({(.assetId): .}) | add // {}) as $m
      | .frames[] | select(.redacted != true and .assetId != null)
      | ($m[.assetId]) as $c
      | if $c == null then "  #\(.n) \(.filename): not in the Lightroom catalog anymore"
        elif $c.redact == 1 then "  #\(.n) \(.filename): now marked Redact, but its image is public"
        elif $c.rating < 1 then "  #\(.n) \(.filename): now unrated"
        else empty end' "$f")"
    report="$report${drift:+${report:+$'\n'}$drift}"
    if [ -n "$report" ]; then
      problems=1
      echo "⚠️  $slug:"; printf '%s\n' "$report"
    else
      echo "✅ $slug: matches Lightroom"
    fi
  done <<<"$files"
  if [ "$problems" = 1 ]; then
    echo "Fix with: bin/lr-roll --album ... --slug <slug> --force (redacted frames are removed from the bucket)" >&2
    exit 1
  fi
  exit 0
fi

# --- Resolve the folder and album ------------------------------------------------
# Albums can sit in Lightroom folders (collection_set). Folders are never
# albums, so a folder and an old album may share a name. --folder limits the
# album lookup to the albums directly in that folder.

FOLDER_ID=""
if [ -n "$FOLDER" ]; then
  fmatches="$(q -separator $'\t' "
    select f.albumId, f.createdTimestamp, (select count(*) from albums c where c.parentId = f.albumId)
    from albums f where f.name = $(sql_str "$FOLDER") and f.subtype = 'collection_set'
    order by f.createdTimestamp;")"
  n="$(printf '%s' "$fmatches" | grep -c . || true)"
  [ "$n" -gt 0 ] || die "no Lightroom folder named \"$FOLDER\" (has it synced? open Lightroom, then quit it)"
  [ "$n" -eq 1 ] || die "\"$FOLDER\" matches $n folders; rename one in Lightroom"
  FOLDER_ID="$(cut -f1 <<<"$fmatches")"
fi
folder_where() { if [ -n "$FOLDER_ID" ]; then echo "and al.parentId = $(sql_str "$FOLDER_ID")"; fi; }

# --- Folder audit: are the albums in a folder sorted into whole lab rolls? ------

if $SUGGEST && [ -n "$FOLDER" ] && [ -z "$ALBUM" ] && [ -z "$ALBUM_ID" ]; then
  rows="$(q -separator $'\t' "
    select al.name, coalesce(a.filename, ''), coalesce(a.rating, 0)
    from albums al left join album_asset_v2 aa on aa.albumId = al.albumId left join assets a on a.assetId = aa.assetId
    where coalesce(al.subtype, '') <> 'collection_set' $(folder_where)
    order by al.name, a.filenameLC;")"
  [ -n "$rows" ] || die "no albums in folder \"$FOLDER\""
  awk -F'\t' -v folder="$FOLDER" '
    $2 == "" { if (!($1 in seen)) { seen[$1] = 1; albums[++na] = $1 }; empty[$1] = 1; next }
    { b = $2; sub(/\.[^.]*$/, "", b)
      p = (b ~ /^[0-9][0-9-]{3,}[0-9]{4}$/) ? substr(b, 1, length(b) - 4) : "(not lab-named)"
      if (!($1 in seen)) { seen[$1] = 1; albums[++na] = $1 }
      cnt[$1]++; if ($3 < 1) un[$1]++
      if (!(($1, p) in ap)) { ap[$1, p] = 1; np[$1]++; plist[$1] = plist[$1] (plist[$1] ? ", " : "") p }
      ac[$1, p]++
      if (!((p, $1) in pa)) { pa[p, $1] = 1; na_p[p]++; alist[p] = alist[p] (alist[p] ? ", " : "") "\"" $1 "\"" }
      if (!(p in ps)) { ps[p] = 1; prefixes[++npx] = p } }
    END {
      printf "Folder \"%s\": %d albums\n", folder, na
      for (i = 1; i <= na; i++) {
        a = albums[i]
        if (empty[a] && !cnt[a]) { printf "  ·  %s: no frames yet\n", a; continue }
        printf "  %s %s: %d frames, lab roll %s%s\n", (np[a] > 1 ? "⚠️ " : "✅"), a, cnt[a], plist[a], (un[a] ? sprintf(", ⛔ %d unrated", un[a]) : "")
      }
      bad = 0
      for (i = 1; i <= npx; i++) if (na_p[prefixes[i]] > 1 && prefixes[i] != "(not lab-named)") {
        if (!bad++) print "Lab rolls split across albums:"
        printf "  ⚠️  %s is in %s\n", prefixes[i], alist[prefixes[i]]
      }
      for (i = 1; i <= na; i++) if (np[albums[i]] > 1) bad++
      if (bad) print "Mixed albums usually mean a frame was sorted into the wrong roll."
      else print "Every album is exactly one lab roll."
    }' <<<"$rows"
  # Roll facts per album: keyword values (with how many frames carry them)
  # and how many frames are marked Portfolio or Redact.
  facts="$(q -separator $'\t' "
    select al.name, lower(trim(substr(k.keyword, 1, instr(k.keyword, ':') - 1))) as key,
           trim(substr(k.keyword, instr(k.keyword, ':') + 1)) as val, count(distinct a.docId),
           (select count(*) from album_asset_v2 x where x.albumId = al.albumId)
    from albums al join album_asset_v2 aa on aa.albumId = al.albumId join assets a on a.assetId = aa.assetId
         join keywords k on k.docId = a.docId
    where coalesce(al.subtype, '') <> 'collection_set' $(folder_where)
      and lower(trim(substr(k.keyword, 1, instr(k.keyword, ':') - 1))) in ('film','camera','lens','lab','title','trip')
    group by al.name, key, val
    union all
    select al.name, lower(trim(k.keyword)), '', count(distinct a.docId),
           (select count(*) from album_asset_v2 x where x.albumId = al.albumId)
    from albums al join album_asset_v2 aa on aa.albumId = al.albumId join assets a on a.assetId = aa.assetId
         join keywords k on k.docId = a.docId
    where coalesce(al.subtype, '') <> 'collection_set' $(folder_where)
      and lower(trim(k.keyword)) in ('portfolio','redact')
    group by al.name, lower(trim(k.keyword))
    order by 1, 2;")"
  if [ -n "$facts" ]; then
    echo; echo "Keywords per album (frames carrying each):"
    awk -F'\t' '
      $1 != last { if (last != "") print ""; printf "  %s:", $1; last = $1 }
      { if ($3 == "") printf "  %s %d", $2, $4
        else printf "  %s: %s%s", $2, $3, ($4 < $5 ? sprintf(" (%d of %d)", $4, $5) : "") }
      END { print "" }' <<<"$facts"
  fi
  exit 0
fi

if [ -z "$ALBUM_ID" ]; then
  matches="$(q -separator $'\t' "
    select al.albumId, al.createdTimestamp, count(aa.assetId),
           coalesce((select f.name from albums f where f.albumId = al.parentId), '(no folder)')
    from albums al left join album_asset_v2 aa on aa.albumId = al.albumId
    where al.name = $(sql_str "$ALBUM") and coalesce(al.subtype,'') <> 'collection_set' $(folder_where)
    group by al.albumId order by al.createdTimestamp;")"
  n="$(printf '%s' "$matches" | grep -c . || true)"
  [ "$n" -gt 0 ] || die "no album named \"$ALBUM\"${FOLDER:+ in folder \"$FOLDER\"}"
  if [ "$n" -gt 1 ]; then
    echo "lr-roll: \"$ALBUM\" matches $n albums; pass --folder or --album-id:" >&2
    printf '%s\n' "$matches" | awk -F'\t' '{printf "  %s  in %s  created %s  %s frames\n", $1, $4, substr($2,1,10), $3}' >&2
    exit 1
  fi
  ALBUM_ID="$(printf '%s' "$matches" | cut -f1)"
fi
[ -n "$ALBUM" ] || ALBUM="$(q "select name from albums where albumId = $(sql_str "$ALBUM_ID");")"
[ -n "$ALBUM" ] || die "no album with id $ALBUM_ID"
# Nathan makes a roll's album when he loads the film, so its creation time is
# when the roll was loaded (and a bound on when it was shot).
ALBUM_CREATED="$(q "select createdTimestamp from albums where albumId = $(sql_str "$ALBUM_ID");")"
LOADED="${ALBUM_CREATED:0:10}"
# The folders the album sits in, from the top (e.g. ["2026 10", "SF Trip"]).
FOLDERS_JSON="$(q -json "
  with recursive up(id, name, depth) as (
    select parentId, null, 0 from albums where albumId = $(sql_str "$ALBUM_ID")
    union all
    select f.parentId, f.name, up.depth + 1 from albums f join up on f.albumId = up.id
    where up.id is not null and up.depth < 20)
  select name from up where name is not null order by depth desc;" | jq -c 'map(.name)')"
[ -n "$FOLDERS_JSON" ] || FOLDERS_JSON="[]"
[ "$FOLDERS_JSON" = "[]" ] || echo "📁 in $(jq -r 'join(" › ")' <<<"$FOLDERS_JSON") (album made $LOADED)"

# Frames of the album, in filename order (the order they were scanned / shot).
# base = filename without extension, used for --from/--to.
frames_sql() {
  local where="aa.albumId = $(sql_str "$ALBUM_ID")"
  local base="upper(rtrim(a.filename, replace(a.filename, '.', '')))"
  base="rtrim($base, '.')"
  [ -z "$FROM" ] || where="$where and $base >= upper($(sql_str "$FROM"))"
  [ -z "$TO" ] || where="$where and $base <= upper($(sql_str "$TO"))"
  $INCLUDE_REJECTED || where="$where and coalesce(a.flag, 0) <> -1"
  cat <<SQL
    attach '$TMP/previews.db' as p;
    select a.docId, a.assetId, a.filename, a.captureDate,
           coalesce(a.rating, 0) as rating, coalesce(a.flag, 0) as flag,
           a.width, a.height, a.orientation,
           (select max(longSide) from p.RenditionPath r where r.localAssetId = a.docId) as previewLongSide,
           cast(strftime('%s', a.captureDate) as integer) as epoch,
           exists(select 1 from keywords k where k.docId = a.docId and lower(trim(k.keyword)) = 'redact') as redact,
           (select json_group_array(k.keyword) from keywords k where k.docId = a.docId) as keywords,
           exists(select 1 from keywords k where k.docId = a.docId and lower(trim(k.keyword)) = 'portfolio') as portfolio,
           (select cast(it.completeTime as integer) from importTime it where it.docId = a.docId) as imported
    from album_asset_v2 aa join assets a on a.assetId = aa.assetId
    where $where
    order by a.filenameLC;
SQL
}

# --- Suggest mode: print likely roll boundaries, write nothing -----------------

if $SUGGEST; then
  all="$(q -separator $'\t' "$(frames_sql)")"
  rows="$(cut -f3,11 <<<"$all")"
  total="$(printf '%s\n' "$rows" | grep -c . || true)"
  [ "$total" -gt 0 ] || die "no frames in \"$ALBUM\""
  echo "$ALBUM: $total frames"
  unrated="$(awk -F'\t' '$5 < 1' <<<"$all" | grep -c . || true)"
  [ "$unrated" -eq 0 ] || echo "⛔ NOT READY: $unrated of $total frames unrated"

  # Lab scans are often named <order/roll number><4 digit frame>.tif (e.g.
  # 000464210001.tif). When most of the album looks like that, each number
  # prefix is one roll, which beats guessing from scan times.
  lab="$(awk -F'\t' '{ b = $3; sub(/\.[^.]*$/, "", b) } b ~ /^[0-9][0-9-]{3,}[0-9]{4}$/ { n++ } END { print (NR > 0 && n / NR >= 0.8) ? 1 : 0 }' <<<"$all")"
  if [ "$lab" = 1 ]; then
    echo
    echo "Lab-style filenames, one roll per number prefix:"
    awk -F'\t' -v album="$ALBUM" '
      { b = $3; sub(/\.[^.]*$/, "", b)
        if (b !~ /^[0-9][0-9-]{3,}[0-9]{4}$/) { other++; next }
        p = substr(b, 1, length(b) - 4)
        if (!(p in n)) { order[++k] = p; lo[p] = b; hi[p] = b }
        n[p]++; if ($5 < 1) u[p]++
        if (b < lo[p]) lo[p] = b; if (b > hi[p]) hi[p] = b }
      END {
        for (i = 1; i <= k; i++) {
          p = order[i]
          printf "  %s: %d frames%s\n    bin/lr-roll --album \"%s\" --from %s --to %s\n", p, n[p], (u[p] ? sprintf(", ⛔ %d unrated", u[p]) : ""), album, lo[p], hi[p]
        }
        if (other) printf "  (%d frames with other names are not in any of these)\n", other
      }' <<<"$all"
    echo
    echo "Add --title, --film, --camera and --shot for each roll."
    exit 0
  fi
  echo
  # Split at time gaps > GAP seconds, then split long segments into
  # roughly equal rolls of ~36-38 frames.
  printf '%s\n' "$rows" | awk -F'\t' -v gap="$GAP" '
    { name[NR] = $1; t[NR] = $2 + 0; sub(/\.[^.]*$/, "", name[NR]) }
    END {
      s = 1; nseg = 0
      for (i = 2; i <= NR + 1; i++) {
        if (i > NR || t[i] - t[i-1] > gap) {
          nseg++; segS[nseg] = s; segE[nseg] = i - 1
          if (i <= NR) gaps = gaps sprintf("  gap of %ds before #%d %s\n", t[i] - t[i-1], i, name[i])
          s = i
        }
      }
      print "Time gaps over " gap "s:"; printf "%s", (gaps ? gaps : "  none\n"); print ""
      print "Suggested rolls:"
      r = 0
      for (k = 1; k <= nseg; k++) {
        len = segE[k] - segS[k] + 1
        rolls = int(len / 37 + 0.5); if (rolls < 1) rolls = 1
        size = len / rolls
        for (j = 0; j < rolls; j++) {
          a = segS[k] + int(j * size + 0.5); b = segS[k] + int((j + 1) * size + 0.5) - 1
          r++
          printf "  roll %d: --from %s --to %s  (%d frames, #%d-#%d)\n", r, name[a], name[b], b - a + 1, a, b
        }
      }
    }'
  echo
  echo "Check these against the scans (blank frames, rebates) before using them."
  exit 0
fi

# --- Build the roll --------------------------------------------------------------

FRAMES_JSON="$(q -json "$(frames_sql)")"
[ -n "$FRAMES_JSON" ] || FRAMES_JSON="[]"
COUNT="$(jq length <<<"$FRAMES_JSON")"
[ "$COUNT" -gt 0 ] || die "no frames matched"

# A roll album holding lab scans from more than one lab roll usually means a
# frame was sorted into the wrong album. Warn, since it's a photo question.
lab_rolls="$(jq -r '[.[] | .filename | sub("\\.[^.]*$"; "") | select(test("^[0-9][0-9-]{3,}[0-9]{4}$")) | .[0:-4]] | unique | join(", ")' <<<"$FRAMES_JSON")"
case "$lab_rolls" in *,*) echo "⚠️  these frames come from more than one lab roll ($lab_rolls); check the album's sorting" >&2 ;; esac

# Nathan rates every frame when he's done going through a roll, so an
# unrated (0 star) frame means the roll isn't finished. No override.
UNRATED="$(jq -r 'to_entries | map(select(.value.rating < 1)) | map("  #\(.key + 1) \(.value.filename)") | .[]' <<<"$FRAMES_JSON")"
N_UNRATED="$(printf '%s' "$UNRATED" | grep -c . || true)"
if [ "$N_UNRATED" -gt 0 ]; then
  echo "⛔ NOT READY: $N_UNRATED of $COUNT frames unrated" >&2
  printf '%s\n' "$UNRATED" >&2
  $DRY_RUN || die "rate every frame (1–5 stars, redacted ones too) in Lightroom before exporting"
fi

# Roll facts from keywords: Nathan selects a roll's frames and adds
# "film: <stock>", "camera: <body>", "lens: <lens>", "lab: <lab>|home".
# FRAMES_JSON gets .kw = { film, camera, lens, lab } per frame.
FRAMES_JSON="$(jq '
  map(. + { kw: ((.keywords // "[]") | fromjson | map(capture("^\\s*(?<k>film|camera|lens|lab|title|trip)\\s*:\\s*(?<v>.*?)\\s*$"; "i"))
               | map(select(.v != "")) | map({ (.k | ascii_downcase): .v }) | add // {}) })' <<<"$FRAMES_JSON")"

# kw_fact key -> prints the agreed value (empty if none or conflicting) and
# warns on stderr about frames missing it or disagreeing.
kw_fact() {
  local key="$1" res
  res="$(jq -r --arg k "$key" '
    . as $f
    | [ $f[] | .kw[$k] | select(. != null) ] as $vals
    | ($vals | group_by(.) | map({ v: .[0], n: length }) | sort_by(-.n)) as $groups
    | if ($vals | length) == 0 then "none"
      elif ($groups | length) > 1 then "conflict\t" + ($groups | map("\(.v) ×\(.n)") | join(", "))
      else
        [ $f | to_entries[] | select(.value.kw[$k] == null) | "#\(.key + 1) \(.value.filename)" ] as $missing
        | "ok\t" + $groups[0].v + "\t" + ($missing | join(", "))
      end' <<<"$FRAMES_JSON")"
  case "$res" in
    none) ;;
    conflict*) echo "⚠️  frames disagree on \"$key:\" (${res#conflict	}); leaving it empty, pass --$key to set it" >&2 ;;
    ok*)
      IFS=$'\t' read -r _ v missing <<<"$res"
      [ -z "$missing" ] || echo "⚠️  \"$key: $v\" is missing on $missing (missed in the selection?)" >&2
      echo "$v" ;;
  esac
}
if [ -z "$FILM" ]; then FILM="$(kw_fact film)"; [ -z "$FILM" ] || echo "🎞  film from keywords: $FILM"; fi
if [ -z "$CAMERA" ]; then CAMERA="$(kw_fact camera)"; [ -z "$CAMERA" ] || echo "📷 camera from keywords: $CAMERA"; fi
if [ -z "$LAB" ]; then LAB="$(kw_fact lab)"; [ -z "$LAB" ] || echo "🧪 lab from keywords: $LAB"; fi
# Trip: --trip, else a shared "trip: …" keyword, else the album's folder
# unless that folder is a date folder like "2026 10" or "2026".
if [ -z "$TRIP" ]; then
  TRIP="$(kw_fact trip)"
  if [ -n "$TRIP" ]; then echo "🧳 trip from keywords: $TRIP"
  else
    parent="$(jq -r '.[-1] // ""' <<<"$FOLDERS_JSON")"
    if [ -n "$parent" ] && ! [[ "$parent" =~ ^[0-9]{4}(\ [0-9]{2})?$ ]]; then TRIP="$parent"; echo "🧳 trip from folder: $TRIP"; fi
  fi
fi

# Lens may vary per frame: the roll gets one only when every frame that has
# a lens agrees and at least half the frames have one.
if [ -z "$LENS" ]; then
  LENS="$(jq -r '[ .[] | .kw.lens | select(. != null) ] as $v
    | if ($v | length) > 0 and ($v | unique | length) == 1 and ($v | length) * 2 >= length then $v[0] else "" end' <<<"$FRAMES_JSON")"
  [ -z "$LENS" ] || echo "🔭 lens from keywords: $LENS"
fi

# Shot date. For scans, captureDate is the scan time, close to the import.
# If Nathan set the capture time in Lightroom, it ends well before the import
# or spreads over more than a scan session; then use its newest month.
if [ -z "$SHOT" ]; then
  read -r SHOT shot_why < <(jq -r '
    def epoch: sub("\\.[0-9]+"; "") | sub("(Z|[+-][0-9:]+)$"; "") | strptime("%Y-%m-%dT%H:%M:%S") | mktime;
    def imp: tostring | strptime("%Y%m%d%H%M%S") | mktime;
    [ .[] | .captureDate | select(. != null) ] as $c
    | [ .[] | .imported | select(. != null) ] as $i
    | if ($c | length) == 0 then "- no_capture_dates"
      else ($c | map(epoch)) as $e
        | (($e | max) - ($e | min)) as $span
        | (if ($i | length) > 0 then (($i | map(imp) | min) - ($e | max)) else 0 end) as $before
        | if $before > 172800 or $span > 43200
          then (($c | max)[0:7]) + " capture_times_(" + (if $before > 172800 then "\($before / 86400 | floor)_days_before_import" else "spread_over_\($span / 3600 | floor)h" end) + ")"
          else "- looks_like_the_scan_session" end
      end' <<<"$FRAMES_JSON")
  # Next: Nathan files rolls under month folders ("2026 10" › "SF Film
  # Photos" › "01 - Delta 400"), so the nearest such folder is the shot month.
  if [ "$SHOT" = "-" ]; then
    f="$(jq -r '[ .[] | select(test("^[0-9]{4}[ -][0-9]{2}$")) ] | last // ""' <<<"$FOLDERS_JSON")"
    if [ -n "$f" ]; then SHOT="${f:0:4}-${f:5:2}"; shot_why="folder_${f// /_}"; fi
  fi
  # Fallback: an album made more than 2 days before the scans were imported
  # was made when the film was loaded, so its month is when the roll was shot.
  if [ "$SHOT" = "-" ] && [ -n "$ALBUM_CREATED" ]; then
    read -r s2 why2 < <(jq -r --arg created "$ALBUM_CREATED" '
      def imp: tostring | strptime("%Y%m%d%H%M%S") | mktime;
      ($created | sub("\\.[0-9]+"; "") | sub("Z$"; "") | strptime("%Y-%m-%dT%H:%M:%S") | mktime) as $c
      | [ .[] | .imported | select(. != null) | imp ] as $i
      | if ($i | length) > 0 and (($i | min) - $c) > 172800
        then ($created[0:7]) + " album_created_\((($i | min) - $c) / 86400 | floor)_days_before_import"
        else "- x" end' <<<"$FRAMES_JSON")
    if [ "$s2" != "-" ]; then SHOT="$s2"; shot_why="$why2"; fi
  fi
  if [ "$SHOT" = "-" ]; then
    SHOT=""; echo "🗓  shot date unknown (${shot_why//_/ }; album made after the scans): pass --shot YYYY-MM or set the capture time in Lightroom" >&2
  else
    echo "🗓  shot $SHOT from ${shot_why//_/ }"
  fi
fi

# Lightroom captions (xmp.dc.description) from the catalog, keyed by assetId.
# Nathan writes "Film stock • format • lab" there, and lines starting with
# ">" are a comment on that frame.
command -v deno >/dev/null || die "missing deno (needed to read captions)"
ids="$(jq -r 'map("'"'"'" + .assetId + "'"'"'") | join(",")' <<<"$FRAMES_JSON")"
DESC_JSON="$(sqlite3 -readonly -json "$TMP/catalog.db" "
  select d.fullDocId as id, hex(cast(r.content as blob)) as h
  from docs d join revs r on r.sequence = d.winningRevSequence
  where d.fullDocId in ($ids);" | deno run -q "$REPO_ROOT/bin/lr-meta.ts")"
[ -n "$DESC_JSON" ] || DESC_JSON="{}"

# Roll facts from the captions: the first "•" segment is the film stock,
# and a "Half frame" / "35mm" segment sets the format. Only used when every
# captioned frame agrees and the value wasn't given on the command line.
roll_fact() { # jq filter over the list of caption segment arrays -> unique value or empty
  jq -r --argjson d "$DESC_JSON" '
    [ $d[] | .desc | split("\n") | map(select(test("^\\s*>") | not)) | join(" ")
      | select(test("^\\s*$|^OLYMPUS DIGITAL CAMERA$") | not)
      | split("•") | map(gsub("^\\s+|\\s+$"; "")) ]
    | '"$1"' | unique | if length == 1 then .[0] else "" end' <<<"{}"
}
if [ -z "$FILM" ]; then
  FILM="$(roll_fact 'map(.[0])')"
  [ -z "$FILM" ] || echo "🎞  film from Lightroom captions: $FILM"
fi
if ! $FORMAT_SET; then
  f="$(roll_fact 'map(if any(.[]; test("^half.?frame$"; "i")) then "half-frame" elif any(.[]; . == "35mm") then "35mm" else "" end)')"
  if [ -n "$f" ]; then FORMAT="$f"; echo "🎞  format from Lightroom captions: $FORMAT"; fi
fi

# Title: --title, else a "title: …" keyword all frames share, else the album
# name without a leading "NN - " (Nathan numbers his roll albums).
if [ -z "$TITLE" ]; then
  TITLE="$(kw_fact title)"
  [ -z "$TITLE" ] || echo "🏷  title from keywords: $TITLE"
fi
[ -n "$TITLE" ] || TITLE="$(printf '%s' "$ALBUM" | sed -E 's/^[0-9]+[[:space:]]*[-–—.][[:space:]]*//')"
SCANNED="$(jq -r '.[0].captureDate[0:10]' <<<"$FRAMES_JSON")"
# URLs follow Nathan's Lightroom folders, permanently: "2026 10" › "SF Film
# Photos" › "01 - Delta 400" lives at /photos/2026-10/sf-film-photos/01-delta-400/.
# The album keeps its number in the URL (unique, ordered); the title drops it.
slugify() { printf '%s' "$1" | iconv -f utf-8 -t ascii//TRANSLIT 2>/dev/null \
  | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g'; }
ROLL_PATH=""
while IFS= read -r part; do
  [ -n "$part" ] || continue
  s="$(slugify "$part")"; [ -n "$s" ] && ROLL_PATH="${ROLL_PATH:+$ROLL_PATH/}$s"
done < <(jq -r '.[]' <<<"$FOLDERS_JSON")
a="$(slugify "$ALBUM")"; [ -n "$a" ] || die "album name \"$ALBUM\" has nothing to make a URL from"
ROLL_PATH="${ROLL_PATH:+$ROLL_PATH/}$a"
# The slug is the path flattened: a unique id for the roll (and its R2 prefix).
[ -n "$SLUG" ] || SLUG="${ROLL_PATH//\//-}"
[[ "$SLUG" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "bad slug: $SLUG"

OUT="$OUT_ROOT/$ROLL_PATH"
PAD=${#COUNT}; [ "$PAD" -ge 2 ] || PAD=2

echo "📷 $ALBUM → /photos/$ROLL_PATH/ ($COUNT frames, id $SLUG)"

if $DRY_RUN; then
  jq -r --argjson d "$DESC_JSON" '.[] | "  \(.filename)  \(.captureDate)  ★\(.rating)  flag \(.flag)  preview \(.previewLongSide // "none")"
    + (if .redact == 1 then "  REDACTED" else "" end)
    + (($d[.assetId].text // "") | split("\n") | map(select(test("^\\s*>"))) | if length > 0 then "  💬 " + (join(" ") | .[0:60]) else "" end)' <<<"$FRAMES_JSON"
  echo "(dry run, nothing written to $OUT)"
  exit 0
fi

OLD_URLS=""
if ${NO_PREVIEWS:-false} && [ -z "$EXPORT_DIR" ]; then
  die "no preview index and no --export-dir, so there are no images to export (quit Lightroom and retry)"
fi

if [ -e "$OUT" ]; then
  $FORCE || die "$OUT exists (use --force to replace its roll.json and images)"
  # Remember what the old roll.json pointed at, so uploads it no longer uses
  # (re-exports, newly redacted frames) can be deleted from the bucket.
  if [ -f "$OUT/roll.json" ]; then
    OLD_URLS="$(jq -r '.frames[] | .image, .thumb | select(. != null)' "$OUT/roll.json")"
  fi
  find "$OUT" -maxdepth 1 -type f \( -name 'roll.json' -o -name '[0-9]*.jpg' \) -delete
fi
mkdir -p "$OUT"

# Local mode writes JPEGs beside roll.json. Upload mode renders them in the
# temp dir (removed on exit), uploads, and refers to them by absolute URL.
if $LOCAL; then IMG_DIR="$OUT"; else IMG_DIR="$TMP/img"; mkdir -p "$IMG_DIR"; fi

# finish_image file -> the value for roll.json (relative name or URL).
# Uploaded names carry a short content hash, so a re-export never collides
# with a cached older version and the objects can be cached as immutable.
finish_image() {
  local f="$1" name hash key
  if $LOCAL; then basename "$f"; return; fi
  name="$(basename "$f" .jpg)"
  hash="$(shasum -a 256 "$f" | cut -c1-10)"
  key="rolls/$SLUG/$name.$hash.jpg"
  npx --yes wrangler@latest r2 object put "$BUCKET/$key" --remote --file "$f" \
    --content-type image/jpeg --cache-control "public, max-age=31536000, immutable" \
    >"$TMP/upload.log" 2>&1 || { cat "$TMP/upload.log" >&2; die "upload failed for $key"; }
  echo "$BASE_URL/$key"
}

preview_path() { # docId longSide -> path of that rendition, or the largest if longSide is empty
  local order="longSide desc"
  if [ -n "$2" ]; then order="(longSide = $2) desc, longSide desc"; fi
  sqlite3 -readonly "$TMP/previews.db" \
    "select path from RenditionPath where localAssetId = $1 order by $order limit 1;"
}

web_jpeg() { # src dest longSide: baseline sRGB JPEG, metadata stripped, never upscaled
  magick "$1" -auto-orient -colorspace sRGB -resize "${3}x${3}>" \
    -strip -interlace none -quality 80 "$2"
}

long_side() { magick identify -format '%[fx:max(w,h)]' "$1"; }

FRAME_OBJS="$TMP/frames.jsonl"
: > "$FRAME_OBJS"
i=0
while IFS= read -r row; do
  i=$((i + 1))
  num="$(printf "%0${PAD}d" "$i")"
  docId="$(jq -r .docId <<<"$row")"
  filename="$(jq -r .filename <<<"$row")"
  base="${filename%.*}"

  assetId="$(jq -r .assetId <<<"$row")"
  redacted=false
  [ "$(jq -r .redact <<<"$row")" = 1 ] && redacted=true
  # The ">" lines of the caption, without the marker, as markdown.
  caption="$(jq -r --argjson d "$DESC_JSON" --arg id "$assetId" \
    '($d[$id].text // "") | split("\n") | map(select(test("^\\s*>")) | sub("^\\s*>\\s?"; "")) | join("\n")' <<<"{}")"

  src=""
  if $redacted; then
    : # keep the frame's place on the strip, but never render or upload it
  elif [ -n "$EXPORT_DIR" ]; then
    src="$(find "$EXPORT_DIR" -maxdepth 1 -type f -iname "$base.jp*g" | head -1)"
    [ -n "$src" ] || echo "  ⚠️  $filename not in export dir, using preview" >&2
  fi
  $redacted || [ -n "$src" ] || src="$(preview_path "$docId" "")"
  if $redacted; then
    image=null thumb=null longest=null caption=""
  elif [ -z "$src" ] || [ ! -f "$src" ]; then
    echo "  ⚠️  $filename has no preview, skipping image (open the album in Lightroom to render one)" >&2
    image=null thumb=null longest=null
  else
    web_jpeg "$src" "$IMG_DIR/$num.jpg" "$MAX"
    thumb_src="$(preview_path "$docId" 640)"
    [ -f "$thumb_src" ] || thumb_src="$src"
    web_jpeg "$thumb_src" "$IMG_DIR/$num.thumb.jpg" 640
    longest="$(long_side "$IMG_DIR/$num.jpg")"
    image_ref="$(finish_image "$IMG_DIR/$num.jpg")" || exit 1
    thumb_ref="$(finish_image "$IMG_DIR/$num.thumb.jpg")" || exit 1
    image="$(jq -Rn --arg v "$image_ref" '$v')" thumb="$(jq -Rn --arg v "$thumb_ref" '$v')"
  fi

  # Lightroom's width/height are already post-crop and oriented (portrait
  # frames come out taller than wide), so they are used as is.
  # A redacted frame keeps its position, shape, rating and flag, but no
  # image, filename, assetId or caption, so nothing of the photo is published.
  jq -c --argjson n "$i" --argjson image "$image" --argjson thumb "$thumb" \
    --argjson longest "$longest" --arg caption "$caption" --argjson redacted "$redacted" '
    if $redacted then
      { n: $n, redacted: true, rating, flag, width, height, thumb: null, image: null, imageLongSide: null }
    else
      { n: $n, assetId, filename, rating, flag, width, height,
        thumb: $thumb, image: $image, imageLongSide: $longest,
        caption: (if $caption == "" then null else $caption end),
        portfolio: (.portfolio == 1),
        lens: (.kw.lens // null) }
    end' <<<"$row" >> "$FRAME_OBJS"
  printf '  %s %s%s\n' "$num" "$filename" "$($redacted && echo '  (redacted)')"
done < <(jq -c '.[]' <<<"$FRAMES_JSON")

nullable() { if [ -n "$1" ]; then jq -Rn --arg v "$1" '$v'; else echo null; fi; }

jq -s \
  --arg slug "$SLUG" --arg path "$ROLL_PATH" --arg title "$TITLE" --arg format "$FORMAT" \
  --arg scanned "$SCANNED" --arg album "$ALBUM" \
  --argjson film "$(nullable "$FILM")" --argjson camera "$(nullable "$CAMERA")" \
  --argjson shot "$(nullable "$SHOT")" --argjson notes "$(nullable "$NOTES")" \
  --argjson from "$(nullable "$FROM")" --argjson to "$(nullable "$TO")" \
  --argjson lens "$(nullable "$LENS")" --argjson lab "$(nullable "$LAB")" \
  --argjson loaded "$(nullable "$LOADED")" \
  --argjson trip "$(nullable "$TRIP")" --argjson folders "$FOLDERS_JSON" \
  '{
    slug: $slug, path: $path, title: $title, film: $film, format: $format, camera: $camera,
    lens: $lens, lab: $lab, trip: $trip, folders: $folders,
    loaded: $loaded, shot: $shot, scanned: $scanned, notes: $notes,
    source: { album: $album, from: $from, to: $to },
    frames: .
  }' "$FRAME_OBJS" > "$OUT/roll.json"

# Delete uploads the previous roll.json used that this one doesn't (only our
# own bucket URLs). Cloudflare may still serve cached copies for a while.
if [ -n "$OLD_URLS" ] && ! $LOCAL; then
  NEW_URLS="$(jq -r '.frames[] | .image, .thumb | select(. != null)' "$OUT/roll.json")"
  while IFS= read -r url; do
    case "$url" in "$BASE_URL"/*) ;; *) continue ;; esac
    grep -qxF "$url" <<<"$NEW_URLS" && continue
    key="${url#"$BASE_URL"/}"
    if npx --yes wrangler@latest r2 object delete "$BUCKET/$key" --remote >"$TMP/delete.log" 2>&1; then
      echo "  🗑  removed $key"
      DELETED="${DELETED:-}$url"$'\n'
    else
      echo "  ⚠️  could not remove $key" >&2; cat "$TMP/delete.log" >&2
    fi
  done <<<"$OLD_URLS"
fi

# Deleted objects were served as immutable for a year, so Cloudflare's edge
# may keep serving them. The wrangler login can't purge cache; a token with
# Zone > Cache Purge for nathanherald.com in $CLOUDFLARE_PURGE_TOKEN can.
ZONE_ID="${LR_ZONE_ID:-e9d322105e0e1219b246c7dc1c12fcbc}"
if [ -n "${DELETED:-}" ]; then
  if [ -n "${CLOUDFLARE_PURGE_TOKEN:-}" ]; then
    printf '%s' "$DELETED" | grep . | split -l 30 - "$TMP/purge."
    for part in "$TMP"/purge.*; do
      body="$(jq -Rn '{files: [inputs]}' <"$part")"
      if curl -fsS -X POST "https://api.cloudflare.com/client/v4/zones/$ZONE_ID/purge_cache" \
          -H "Authorization: Bearer $CLOUDFLARE_PURGE_TOKEN" -H 'Content-Type: application/json' \
          --data "$body" >/dev/null; then
        echo "  🧹 purged $(grep -c . "$part") URLs from Cloudflare's cache"
      else
        echo "  ⚠️  cache purge failed; purge these by hand:" >&2; cat "$part" >&2
      fi
    done
  else
    echo "" >&2
    echo "⚠️  These deleted images may still be served from Cloudflare's cache for up to a year:" >&2
    printf '%s' "$DELETED" | sed 's/^/    /' >&2
    echo "   Purge them in the dashboard (nathanherald.com › Caching › Purge Cache › Custom Purge)," >&2
    echo "   or set CLOUDFLARE_PURGE_TOKEN (an API token with Zone › Cache Purge for zone $ZONE_ID) and rerun." >&2
  fi
fi

n_img="$(find "$IMG_DIR" -name '*.jpg' | wc -l | tr -d ' ')"
if $LOCAL; then
  echo "✅ Wrote $OUT/roll.json and $n_img images ($(du -sh "$OUT" | cut -f1))"
else
  echo "✅ Uploaded $n_img images ($(du -sh "$IMG_DIR" | cut -f1)) to $BUCKET/rolls/$SLUG/ and wrote $OUT/roll.json"
fi
